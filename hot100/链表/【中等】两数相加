# 两数相加

## 题目
https://leetcode.cn/problems/add-two-numbers/?envType=study-plan-v2&envId=top-100-liked

## 解题
注意加上进位并且判断各种边界条件
```go
/**
 * Definition for singly-linked list.
 * type ListNode struct {
 *     Val int
 *     Next *ListNode
 * }
 */
func addTwoNumbers(l1 *ListNode, l2 *ListNode) *ListNode {
    var res, temp *ListNode
    carry := 0
    for l1 != nil || l2 != nil {
        n1, n2 := 0, 0
        if l1 != nil {
            n1 = l1.Val
            l1 = l1.Next
        }
        if l2 != nil {
            n2 = l2.Val
            l2 = l2.Next
        }
        sum := n1 + n2 + carry  // n1 + n2 + 进位
        sum, carry = sum%10, sum/10
        if res == nil {
            res = &ListNode{Val: sum,}
            temp = res 
        } else {
            temp.Next = &ListNode{Val: sum,}
            temp = temp.Next  // 注意放在里边
        }
    }
    if carry > 0 {
        temp.Next = &ListNode{Val: carry,} 
    }
    return res
}

```